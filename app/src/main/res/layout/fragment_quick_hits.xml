<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".QuickHitsFragment">

    <androidx.drawerlayout.widget.DrawerLayout
        android:id="@+id/drawer_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bgBlack">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/main"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/bgBlack">

                <!-- Horizontal Scroll View for Cards -->
                <HorizontalScrollView
                    android:id="@+id/horizontalScrollViewCards"
                    android:layout_width="wrap_content"
                    android:layout_height="240dp"
                    android:foregroundGravity="center"
                    android:fillViewport="true"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:layout_marginTop="27dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="240dp"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <!-- Card for Monthly Expense -->
                        <androidx.cardview.widget.CardView
                            android:id="@+id/scrollableCards1"
                            android:layout_width="366dp"
                            android:layout_height="200dp"
                            android:layout_marginHorizontal="20dp"
                            app:cardCornerRadius="11dp"
                            app:cardElevation="11dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/background_color"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_margin="11dp"
                                    android:fontFamily="@font/montserratregular"
                                    android:gravity="start"
                                    android:text="This Month's Expense"
                                    android:textColor="@color/white"
                                    android:textSize="27sp" />

                                <TextView
                                    android:id="@+id/tExpense"
                                    android:layout_width="wrap_content"
                                    android:layout_height="78dp"
                                    android:layout_gravity="bottom|center"
                                    android:layout_margin="11dp"
                                    android:layout_marginTop="150dp"
                                    android:fontFamily="@font/montserratregular"
                                    android:text="\u20b9 7777"
                                    android:textColor="@color/white"
                                    android:textSize="70dp"
                                    android:textStyle="bold" />

                                <ImageButton
                                    android:id="@+id/refreshButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="bottom|right"
                                    android:backgroundTint="@android:color/transparent"
                                    android:contentDescription="refresh"
                                    android:src="@drawable/refresh" />
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <!-- Card for Monthly Credit -->
                        <androidx.cardview.widget.CardView
                            android:id="@+id/scrollableCards2"
                            android:layout_width="380dp"
                            android:layout_height="200dp"
                            android:layout_marginHorizontal="20dp"
                            app:cardBackgroundColor="@color/grey"
                            app:cardCornerRadius="11dp"
                            app:cardElevation="11dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/background_color"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_margin="11dp"
                                    android:fontFamily="@font/montserratregular"
                                    android:gravity="start"
                                    android:text="This Month's Credit!!"
                                    android:textColor="@color/white"
                                    android:textSize="27sp" />

                                <TextView
                                    android:id="@+id/tCredit"
                                    android:layout_width="wrap_content"
                                    android:layout_height="78dp"
                                    android:layout_gravity="bottom|center"
                                    android:layout_margin="11dp"
                                    android:layout_marginTop="150dp"
                                    android:fontFamily="@font/montserratregular"
                                    android:text="\u20b9 7777"
                                    android:textColor="@color/white"
                                    android:textSize="70dp"
                                    android:textStyle="bold" />

                                <ImageButton
                                    android:id="@+id/refreshButton2"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="bottom|right"
                                    android:backgroundTint="@android:color/transparent"
                                    android:contentDescription="refresh"
                                    android:src="@drawable/refresh" />
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- Recent Transactions Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginVertical="35dp"
                    app:layout_constraintTop_toBottomOf="@id/horizontalScrollViewCards">

                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/recentTransTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:textStyle="bold"
                            android:fontFamily="@font/montserratregular"
                            android:gravity="center"
                            android:text="Recent Transactions"
                            android:textColor="@color/white"
                            android:textSize="21sp" />

                        <ScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="40dp"
                            android:layout_marginBottom="16dp">

                            <LinearLayout
                                android:id="@+id/transactionContainer"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">
                                <!-- Transaction containers will be added dynamically here -->
                            </LinearLayout>
                        </ScrollView>
                    </RelativeLayout>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>
    </androidx.drawerlayout.widget.DrawerLayout>
</FrameLayout>
